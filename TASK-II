#include <iostream>
using namespace std;

int main()
{
    int a, b;

    for(a = 1; a <= 5; a++)
    {
        for(b = 1; b <= 5; b++)
        {
            if(b == a)
                cout << a;
            else if(b == 6 - a)
                cout << 6 - a;
            else
                cout << " ";
        }
        cout << endl;
    }

    return 0;
}
